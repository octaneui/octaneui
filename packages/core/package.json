{
  "name": "@octaneui/core",
  "version": "0.0.1",
  "type": "module",
  "description": "Core components for Octane UI",
  "license": "ISC",
  "homepage": "https://octaneui.dev",
  "bugs": {
    "url": "https://github.com/octaneui/octaneui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octaneui/octaneui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["octane", "octaneui", "ui", "components"],
  "sideEffects": false,
  "files": ["src", "README.md"],
  "main": "./src/index.tsrx",
  "module": "./src/index.tsrx",
  "types": "./src/index.tsrx",
  "exports": {
    ".": "./src/index.tsrx",
    "./button": "./src/components/Button.tsrx",
    "./input": "./src/components/Input.tsrx",
    "./select": "./src/components/Select.tsrx",
    "./slider": "./src/components/Slider.tsrx",
    "./calendar": "./src/components/Calendar.tsrx",
    "./time": "./src/components/Time.tsrx",
    "./checkbox": "./src/components/Checkbox.tsrx",
    "./radio": "./src/components/Radio.tsrx",
    "./switch": "./src/components/Switch.tsrx",
    "./textarea": "./src/components/Textarea.tsrx",
    "./color": "./src/components/Color.tsrx",
    "./file-input": "./src/components/FileInput.tsrx",
    "./progress": "./src/components/Progress.tsrx",
    "./disclosure": "./src/components/Disclosure.tsrx",
    "./tabs": "./src/components/Tabs.tsrx",
    "./dialog": "./src/components/Dialog.tsrx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@octaneui/icons": "workspace:*"
  },
  "peerDependencies": {
    "octane": "^0.1.44"
  },
  "devDependencies": {
    "@octanejs/vite-plugin": "^0.1.44",
    "@tsrx/prettier-plugin": "^0.3.124",
    "@tsrx/typescript-plugin": "^0.3.124",
    "octane": "^0.1.44",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
