{
  "name": "octane-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter octane-ui-docs dev",
    "build": "bun run --filter octane-ui-docs build",
    "preview": "bun run --filter octane-ui-docs preview",
    "typecheck": "bun run --filter '*' typecheck",
    "deploy": "bun run --filter octane-ui-docs deploy"
  },
  "devDependencies": {
    "@tsrx/prettier-plugin": "^0.3.135",
    "prettier": "^3.9.6"
  }
}
